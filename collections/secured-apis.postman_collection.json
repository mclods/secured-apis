        {
          "name": "6. Get Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const users = pm.response.json();\r",
                  "\r",
                  "const installationUser = users.find(user =>\r",
                  "    user.roles.some(role => role.name === \"ROLE_INSTALLATION_USER\")\r",
                  ");\r",
                  "\r",
                  "if (installationUser) {\r",
                  "    pm.environment.set(\"InstallationUserId\", installationUser.id);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
